{
  "name": "monitoring-get-started",
  "version": "1.0.0",
  "description": "Express.js application with monitoring endpoints",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "npx nodemon index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:up-dev": "docker-compose --profile dev up app-dev --force-recreate",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "monitoring:up": "docker-compose --profile monitoring up -d",
    "monitoring:down": "docker-compose --profile monitoring down",
    "monitoring:dev": "docker-compose --profile dev --profile monitoring up -d --force-recreate",
    "monitoring:production": "docker-compose --profile monitoring --profile production up -d",
    "monitoring:logs": "docker-compose logs -f prometheus grafana node-exporter"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
